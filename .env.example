# ============================================
# Wayfarer AI — Environment Variables
# ============================================

# --- Frontend (Next.js) ---
NEXTAUTH_URL=http://localhost:3000
# Required. The app refuses to start in production without this.
NEXTAUTH_SECRET=your-nextauth-secret-here

# Google OAuth (NextAuth). Google sign-in is disabled when these are missing.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend (FastAPI) ---
# "development" | "production". In production the backend refuses to boot
# with a weak or default JWT_SECRET.
ENVIRONMENT=development
PROJECT_NAME=Wayfarer AI Backend
VERSION=1.0.0
API_V1_STR=/api/v1

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/wayfarer_ai
DB_NAME=wayfarer_ai

# JWT — must be a strong, unique value (>= 32 chars) in production
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_ISSUER=wayfarer-ai
JWT_AUDIENCE=wayfarer-ai-app
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Same Google client ID as the frontend. Required for the backend to verify
# Google ID tokens at POST /api/v1/auth/google.
GOOGLE_CLIENT_ID=your-google-client-id

# Google Gemini (AI Studio)
GEMINI_API_KEY=your-gemini-api-key

# Amadeus API (currently unused by the backend)
AMADEUS_API_KEY=your-amadeus-api-key
AMADEUS_API_SECRET=your-amadeus-api-secret

# SerpAPI
SERPAPI_API_KEY=your-serpapi-key

# Google Places API
GOOGLE_PLACES_API_KEY=your-google-places-key

# CORS — explicit allow-list (credentialed requests cannot use "*")
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FRONTEND_URL=http://localhost:3000
